// Sehhati — Prisma schema
// Provider PostgreSQL. Voir README pour le lancement local.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
}

enum AccessScope {
  LINK_ONLY
  VITALS
  FULL
}

enum ConsultationStatus {
  DRAFT
  RECORDING
  PROCESSING
  AI_REVIEW
  COMPLETED
  LINKED
}

enum CreationMode {
  MANUAL
  AI
}

enum RecordingStatus {
  RECORDING
  PAUSED
  FINISHED
  UPLOADING
  READY
  FAILED
  DELETED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum JobType {
  TRANSCRIBE
  EXTRACT
  PURGE
}

enum ConsentType {
  AUDIO
  AI_PROCESSING
  RETENTION
  PATIENT_QR
}

enum LinkMethod {
  PATIENT_QR
  DOCTOR_CODE
  ACCESS_GRANT
}

enum Locale {
  ar
  fr
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role
  fullName     String
  phone        String?
  locale       Locale   @default(ar)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patient       Patient?
  doctor        Doctor?
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Patient {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientCode     String    @unique // ex: SH-482913
  birthDate       DateTime?
  gender          String?
  bloodType       String?
  allergies       String[]
  chronicDiseases String[]
  createdAt       DateTime  @default(now())

  consultations Consultation[]
  linkTokens    PatientLinkToken[]
  accessGrants  AccessGrant[]
}

model Doctor {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty     String
  licenseNumber String?
  clinicName    String?
  city          String?
  createdAt     DateTime @default(now())

  consultations Consultation[]
  accessGrants  AccessGrant[]
}

model Consultation {
  id              String             @id @default(cuid())
  doctorId        String
  doctor          Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId       String?
  patient         Patient?           @relation(fields: [patientId], references: [id])
  status          ConsultationStatus @default(DRAFT)
  consultedAt     DateTime           @default(now())
  reason          String             @default("")
  symptoms        String?
  examination     String?
  diagnosis       String?
  treatment       String?
  recommendations String?
  followUpDate    DateTime?
  linkedAt        DateTime?
  linkMethod      LinkMethod?
  hiddenByPatient Boolean            @default(false)
  creationMode    CreationMode       @default(MANUAL)
  aiMeta          Json?
  validatedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  prescriptions    Prescription[]
  attachments      Attachment[]
  claimCode        ClaimCode?
  consents         RecordingConsent[]
  recording        Recording?
  transcript       Transcript?
  extractions      AiExtraction[]
  jobs             ProcessingJob[]
  recorderSessions RecorderSession[]

  @@index([patientId, consultedAt])
  @@index([doctorId, consultedAt])
  @@index([status])
}

model Prescription {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  medication     String
  dosage         String
  frequency      String
  duration       String
  notes          String?
  position       Int          @default(0)
}

model Attachment {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  fileName       String
  mimeType       String
  sizeBytes      Int
  storagePath    String
  kind           String // LAB, IMAGING, PRESCRIPTION, OTHER
  createdAt      DateTime     @default(now())
}

model PatientLinkToken {
  id          String      @id @default(cuid())
  patientId   String
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  tokenHash   String      @unique
  codeHash    String      @unique
  expiresAt   DateTime
  usedAt      DateTime?
  scope       AccessScope @default(LINK_ONLY)
  durationMin Int         @default(120)
  createdAt   DateTime    @default(now())

  @@index([patientId, expiresAt])
}

model AccessGrant {
  id           String      @id @default(cuid())
  patientId    String
  patient      Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId     String
  doctor       Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  scope        AccessScope // VITALS ou FULL uniquement
  createdAt    DateTime    @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  lastAccessAt DateTime?
  accessCount  Int         @default(0)

  @@unique([patientId, doctorId])
  @@index([patientId, expiresAt])
  @@index([doctorId, expiresAt])
}

model ClaimCode {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  codeHash       String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String?
  entityId   String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

// ————————————————————————————————————————————————
// Consultation assistée par IA
// ————————————————————————————————————————————————

/// Consentement explicite du médecin (et éventuellement du patient par QR).
/// Une ligne par type de consentement pour conserver une trace auditable.
model RecordingConsent {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  type           ConsentType
  granted        Boolean      @default(true)
  method         String       @default("DOCTOR_ATTESTATION") // DOCTOR_ATTESTATION | PATIENT_QR
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())

  @@unique([consultationId, type])
  @@index([consultationId])
}

model Recording {
  id             String          @id @default(cuid())
  consultationId String          @unique
  consultation   Consultation    @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  status         RecordingStatus @default(RECORDING)
  mimeType       String          @default("audio/webm")
  durationSec    Int             @default(0)
  chunkCount     Int             @default(0)
  storagePath    String?
  sizeBytes      Int             @default(0)
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?
  expiresAt      DateTime?
  deletedAt      DateTime?
  error          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  transcript Transcript?

  @@index([status])
  @@index([expiresAt])
}

model Transcript {
  id             String       @id @default(cuid())
  consultationId String       @unique
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  recordingId    String?      @unique
  recording      Recording?   @relation(fields: [recordingId], references: [id], onDelete: SetNull)
  language       String       @default("fr")
  text           String       @default("")
  segments       Json         @default("[]")
  provider       String       @default("mock")
  model          String?
  purgedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  extractions AiExtraction[]
}

model AiExtraction {
  id               String       @id @default(cuid())
  consultationId   String
  consultation     Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  transcriptId     String?
  transcript       Transcript?  @relation(fields: [transcriptId], references: [id], onDelete: SetNull)
  version          Int          @default(1)
  provider         String
  model            String?
  promptVersion    String       @default("v1")
  data             Json
  raw              Json?
  missingFields    String[]     @default([])
  unverifiedFields String[]     @default([])
  warnings         Json?
  status           String       @default("DRAFT") // DRAFT | SUPERSEDED
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([consultationId, version])
  @@index([consultationId, createdAt])
}

model ProcessingJob {
  id             String        @id @default(cuid())
  consultationId String?
  consultation   Consultation? @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  type           JobType
  status         JobStatus     @default(QUEUED)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  runAt          DateTime     @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  error          String?
  payload        Json?
  result         Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, runAt])
  @@index([consultationId, type])
}

/// Appairage « téléphone comme micro » : jeton court, usage unique, 10 minutes.
model RecorderSession {
  id             String       @id @default(cuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  recordingId    String
  tokenHash      String       @unique
  pairingCode    String       @unique
  expiresAt      DateTime
  usedAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([consultationId])
  @@index([expiresAt])
}
