# Copier vers .env puis adapter
DATABASE_URL="postgresql://sehhati:sehhati@localhost:5433/sehhati?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-with-openssl-rand-base64-32"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Consultation assistée par IA ---
# Sans REDIS_URL : file PostgreSQL + exécution inline (aucun Redis requis).
# REDIS_URL="redis://localhost:6379"
INLINE_JOBS="1"
QUEUE_DRIVER="db"
WORKER_POLL_MS="2000"
JOB_BACKOFF_MS="5000"

# STT : mock | ai-service | openai
STT_PROVIDER="mock"
# STT_SERVICE_URL="http://localhost:8001"
# LLM : mock | openai | anthropic | ollama
LLM_PROVIDER="mock"
# LLM_API_KEY=""
# LLM_MODEL="gpt-4o-mini"

AUDIO_RETENTION_DAYS="7"
TRANSCRIPT_RETENTION_DAYS="30"
MAX_AUDIO_MINUTES="60"

# Secret du endpoint de purge planifiée (/api/cron/purge).
# En production, sans ce secret, le endpoint refuse les appels (401).
# CRON_SECRET="change-me"
